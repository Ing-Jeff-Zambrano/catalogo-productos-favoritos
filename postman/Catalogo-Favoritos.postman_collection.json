{
  "info": {
    "name": "Catalogo Productos Favoritos",
    "description": "Coleccion de pruebas para la API REST de catalogo con favoritos y roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "{{baseUrl}}" },
    { "key": "tokenUsuarioA", "value": "" },
    { "key": "tokenUsuarioB", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "correoA", "value": "usuario.a@test.local" },
    { "key": "correoB", "value": "usuario.b@test.local" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro usuario A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Rol usuario', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.usuario.rol).to.eql('usuario');",
                  "  pm.expect(body.usuario).to.not.have.property('password_hash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario A\",\n  \"correo\": \"{{correoA}}\",\n  \"password\": \"clave123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        },
        {
          "name": "Registro correo duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Duplicado\",\n  \"correo\": \"{{correoA}}\",\n  \"password\": \"clave123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        },
        {
          "name": "Login usuario A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve token', function () { pm.expect(body.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('tokenUsuarioA', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoA}}\",\n  \"password\": \"clave123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login credenciales incorrectas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoA}}\",\n  \"password\": \"clave-incorrecta\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Registro usuario B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario B\",\n  \"correo\": \"{{correoB}}\",\n  \"password\": \"clave123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        },
        {
          "name": "Login usuario B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('tokenUsuarioB', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoB}}\",\n  \"password\": \"clave123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Rol administrador', function () { pm.expect(body.usuario.rol).to.eql('administrador'); });",
                  "pm.collectionVariables.set('tokenAdmin', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos (publico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tiene productos', function () {",
                  "  pm.expect(pm.response.json().productos).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Filtrar por categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/productos?categoria=Electronica"
          }
        },
        {
          "name": "Crear producto sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No autorizado\",\n  \"descripcion\": \"debe fallar\",\n  \"categoria\": \"Test\",\n  \"precio\": 10\n}"
            },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Crear producto con rol usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioA}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No permitido\",\n  \"descripcion\": \"debe fallar\",\n  \"categoria\": \"Test\",\n  \"precio\": 10\n}"
            },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Crear producto como admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('productoId', body.producto.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Postman\",\n  \"descripcion\": \"Creado en pruebas\",\n  \"categoria\": \"Test\",\n  \"precio\": 25.5\n}"
            },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Crear producto precio invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Invalido\",\n  \"descripcion\": \"precio malo\",\n  \"categoria\": \"Test\",\n  \"precio\": 0\n}"
            },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Obtener producto inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/productos/00000000-0000-4000-8000-000000000000"
          }
        },
        {
          "name": "Actualizar producto como admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Postman actualizado\",\n  \"descripcion\": \"Actualizado en pruebas\",\n  \"categoria\": \"Test\",\n  \"precio\": 27.0\n}"
            },
            "url": "{{baseUrl}}/api/productos/{{productoId}}"
          }
        }
      ]
    },
    {
      "name": "Favoritos",
      "item": [
        {
          "name": "Agregar favorito A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioA}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"{{productoId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/favoritos"
          }
        },
        {
          "name": "Favorito duplicado A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioA}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"{{productoId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/favoritos"
          }
        },
        {
          "name": "Favorito producto inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioA}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"00000000-0000-4000-8000-000000000000\"\n}"
            },
            "url": "{{baseUrl}}/api/favoritos"
          }
        },
        {
          "name": "Listar favoritos A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Al menos un favorito', function () {",
                  "  pm.expect(pm.response.json().favoritos.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioA}}" }
            ],
            "url": "{{baseUrl}}/api/favoritos"
          }
        },
        {
          "name": "Listar favoritos B (aislamiento)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const favs = pm.response.json().favoritos;",
                  "pm.test('B no ve favoritos de A', function () {",
                  "  const ids = favs.map(f => f.productoId);",
                  "  pm.expect(ids).to.not.include(pm.collectionVariables.get('productoId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioB}}" }
            ],
            "url": "{{baseUrl}}/api/favoritos"
          }
        },
        {
          "name": "B intenta quitar favorito de A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioB}}" }
            ],
            "url": "{{baseUrl}}/api/favoritos/{{productoId}}"
          }
        },
        {
          "name": "Verificar favorito de A permanece",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Favorito de A sigue', function () {",
                  "  const ids = pm.response.json().favoritos.map(f => f.productoId);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('productoId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioA}}" }
            ],
            "url": "{{baseUrl}}/api/favoritos"
          }
        },
        {
          "name": "Quitar favorito A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenUsuarioA}}" }
            ],
            "url": "{{baseUrl}}/api/favoritos/{{productoId}}"
          }
        },
        {
          "name": "Favoritos sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/favoritos"
          }
        }
      ]
    },
    {
      "name": "Persistencia",
      "item": [
        {
          "name": "Listar productos tras reinicio (manual)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Datos persistidos', function () {",
                  "  pm.expect(pm.response.json().productos.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Reiniciar el servidor Node y ejecutar esta peticion para evidenciar persistencia en PostgreSQL.",
            "url": "{{baseUrl}}/api/productos"
          }
        }
      ]
    }
  ]
}
