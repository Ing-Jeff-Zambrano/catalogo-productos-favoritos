PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/catalogo_favoritos

# JWT (usar un secreto largo y aleatorio en .env local; nunca subir el real)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# Opcional: datos del script npm run db:create-admin
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@catalogo.local
ADMIN_PASSWORD=Admin123!
